<idea-plugin>
    <id>com.habbashx.larv</id>
    <name>Larv Language</name>
    <vendor email="abdalahalhabbash@gmail.com" url="https://github.com/habbashx/larv-language">HabbashX</vendor>
    <description><![CDATA[Full language support for the <b>Larv</b> scripting language.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <actions>
        <action
                id="Larv.CreateClass"
                class="com.habbashx.larv.plugin.project.LarvCreateClassAction"
                text="Larv Class"
                description="Creates a new Larv class file"
                icon="/icons/larv_file.svg">

            <add-to-group group-id="NewGroup" anchor="last"/>

        </action>
    </actions>
    <extensions defaultExtensionNs="com.intellij">

        <fileIconProvider implementation="com.habbashx.larv.plugin.project.LarvFileIconProvider"/>

        <fileType
                name="Larv File"
                implementationClass="com.habbashx.larv.plugin.lang.LarvFileType"
                fieldName="INSTANCE"
                language="Larv"
                extensions="larv"/>

        <lang.parserDefinition
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.parser.LarvParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.highlighting.LarvSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.habbashx.larv.plugin.highlighting.LarvColorSettingsPage"/>

        <annotator
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.annotator.LarvAnnotator"/>

        <localInspection
                language="Larv"
                shortName="LarvInspection"
                displayName="Larv code inspection"
                groupName="Larv"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.habbashx.larv.plugin.inspection.LarvInspection"/>

        <completion.contributor
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.completion.LarvCompletionContributor"
                order="first"/>

        <lang.braceMatcher
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.bracketmatcher.LarvBraceMatcher"/>

        <lang.commenter
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.commenter.LarvCommenter"/>

        <lang.foldingBuilder
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.folding.LarvFoldingBuilder"/>

        <lang.psiStructureViewFactory
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.structure.LarvStructureViewFactory"/>

        <lang.formatter
                language="Larv"
                implementationClass="com.habbashx.larv.plugin.formatting.LarvFormattingModelBuilder"/>

        <quoteHandler
                fileType="Larv File"
                className="com.habbashx.larv.plugin.formatting.LarvQuoteHandler"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/LarvDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/LarvDarcula.xml"/>

        <!-- ── New Project Wizard ────────────────────────────────────────── -->
        <!--
            LarvModuleBuilder drives the "New Project" wizard step.
            It appears under File > New > Project... as a top-level "Larv" group.
        -->
        <moduleBuilder
                builderClass="com.habbashx.larv.plugin.project.LarvModuleBuilder"
                id="larv.module.builder"
                order="last"/>

        <!--
            LarvProjectType registers the Larv group and template card in the
            legacy "New Project from Template" dialog (used by older IDE versions).
        -->
        <projectTemplatesFactory
                implementation="com.habbashx.larv.plugin.project.LarvProjectType"/>

    </extensions>
</idea-plugin>